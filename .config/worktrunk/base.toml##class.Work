# Personal Worktrunk configuration layered between the EX and Depot fragments.

# Persistent flags for `wt list`.
[list]
full = true
branches = true

# update_labels() is defined in ~/.config/direnv/direnvrc (exports the webpack
# log/pidfile paths and refreshes the Orca workspace label from TICKET_ID and
# UI_PORT).

# Append the update_labels call to the .envrc the ex `envrc` hook just wrote
# (runs after it; the ex hook truncates with >, this appends with >>).
[[pre-start]]
labels = """
WT={{ worktree_path }}
[ -f "$WT/.envrc" ] && printf 'update_labels\\n' >> "$WT/.envrc"
command -v direnv >/dev/null 2>&1 && direnv allow "$WT/.envrc" || true
"""
