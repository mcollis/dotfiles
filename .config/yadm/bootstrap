#!/usr/bin/env bash
set -euo pipefail

readonly YADM_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/yadm"
readonly SCRIPTS_DIR="$YADM_DIR/scripts"

if command -v yadm >/dev/null 2>&1; then
  readonly YADM_BIN="$(command -v yadm)"
elif [[ -x /usr/bin/yadm ]]; then
  readonly YADM_BIN=/usr/bin/yadm
else
  printf '%s\n' 'yadm is required to run bootstrap.' >&2
  exit 1
fi

readonly WORK_SUBMODULES=(".agents/plugins/ex" ".agents/projects/depot")
# Orca's desired configuration is tracked in the private ex submodule, not
# here: this repository is public, so no internal repo names, paths, or hook
# scripts may live in it.
readonly ORCA_CONFIGURE="$HOME/.agents/plugins/ex/contrib/orca/configure.sh"

is_work_machine() {
  "$YADM_BIN" config --get-all local.class 2>/dev/null | grep -qx 'Work'
}

configure_submodule_active() {
  # A submodule with a .gitmodules url is treated as active by Git even
  # before it is ever initialized locally (gitsubmodules(7) ACTIVE
  # SUBMODULES, rule 3). Without an explicit local override, `checkout`,
  # `status`, and an initial `clone --recurse-submodules` would try to
  # populate these private submodules on a Default machine. Force the
  # local override on every run so switching classes takes effect
  # immediately.
  local active=$1 name
  for name in "${WORK_SUBMODULES[@]}"; do
    "$YADM_BIN" gitconfig "submodule.$name.active" "$active"
  done
}

configure_submodule_update_strategy() {
  # `git submodule init` only seeds submodule.<name>.update from .gitmodules
  # when the local key is unset; it never overwrites an existing value
  # (git-submodule(1)). These submodules were already initialized with
  # Git's implicit `checkout` default, which detaches HEAD on every update.
  # Force `merge` locally so `submodule update` advances the current
  # branch instead of detaching it, matching .gitmodules for fresh clones.
  local name
  for name in "${WORK_SUBMODULES[@]}"; do
    "$YADM_BIN" gitconfig "submodule.$name.update" merge
  done
}

configure_submodule_fetch_policy() {
  # A personal ~/.gitconfig with `submodule.recurse = true` makes plain
  # `fetch`/`pull` recurse into every *populated* submodule unconditionally,
  # bypassing both `submodule.<name>.active` and any per-submodule
  # fetchRecurseSubmodules setting. Once these submodules have ever been
  # checked out (e.g. after switching a machine from Work to Default without
  # deinitializing), that surfaces as fetch/auth errors against the private
  # GitLab remotes. An explicit local override restores normal on-demand
  # behavior regardless of class or global user config.
  "$YADM_BIN" gitconfig fetch.recurseSubmodules no
}

copy_if_missing() {
  local source=$1 destination=$2
  if [[ ! -e "$destination" ]]; then
    mkdir -p "$(dirname "$destination")"
    cp "$source" "$destination"
    printf 'Seeded %s\n' "$destination"
  fi
}

replace_legacy_skills_link() {
  local destination=$1 target=$2
  if [[ -L "$destination" ]]; then
    [[ "$(/usr/bin/readlink "$destination")" == "$target" ]] || {
      printf 'Refusing to replace skills link with a different target: %s\n' "$destination" >&2
      exit 1
    }
    rm "$destination"
  elif [[ -e "$destination" && ! -d "$destination" ]]; then
    printf 'Refusing to replace non-directory skills path: %s\n' "$destination" >&2
    exit 1
  fi
  mkdir -p "$destination"
}

configure_agent_skills() {
  local claude_skills="$HOME/.claude/skills"
  local codex_skills="$HOME/.codex/skills"
  local legacy_system_skills="$HOME/.agents/skills/.system"
  local claude_commit_message="$claude_skills/commit-message"

  replace_legacy_skills_link "$codex_skills" '../.agents/skills'
  if [[ -e "$legacy_system_skills" ]]; then
    [[ ! -e "$codex_skills/.system" ]] || {
      printf 'Refusing to overwrite Codex system skills: %s\n' "$codex_skills/.system" >&2
      exit 1
    }
    mv "$legacy_system_skills" "$codex_skills/.system"
  fi

  replace_legacy_skills_link "$claude_skills" '../.agents/skills'
  if [[ ! -e "$claude_commit_message" ]]; then
    ln -s ../../.agents/skills/commit-message "$claude_commit_message"
  elif [[ -L "$claude_commit_message" ]] && [[ "$(/usr/bin/readlink "$claude_commit_message")" != ../../.agents/skills/commit-message ]]; then
    printf 'Refusing to replace Claude commit-message link with a different target.\n' >&2
    exit 1
  elif [[ ! -L "$claude_commit_message" ]]; then
    printf 'Refusing to replace Claude commit-message path: %s\n' "$claude_commit_message" >&2
    exit 1
  fi
}

remove_legacy_opencode_skills_link() {
  local skills="$HOME/.config/opencode/skills"
  if [[ -L "$skills" ]] && [[ "$(/usr/bin/readlink "$skills")" == ../../.agents/plugins/ex/skills ]]; then
    rm "$skills"
  fi
}

# The Stow-era dotfiles installed these into ~/.config/opencode/skills,
# either as links into the ex plugin or as copied directories. .gitignore
# hides that directory from yadm, so removing them from the repository left
# the old copies on disk, where OpenCode still loads them on every machine.
# Only entries that match what the old dotfiles shipped are moved aside, and
# into a backup rather than deleted; anything else there is left alone.
readonly LEGACY_OPENCODE_SKILL_LINKS=(code-review gitlab jira jira-quarter plan-ticket triage-board)
readonly LEGACY_OPENCODE_SKILL_DIRS=(reviewers worktree-prune worktree-claude-sync)

retire_legacy_opencode_skill() {
  local entry=$1 backup_root=$2
  mkdir -p "$backup_root"
  mv "$entry" "$backup_root/"
  printf 'Moved legacy OpenCode skill %s to %s\n' "$entry" "$backup_root"
}

retire_legacy_opencode_skills() {
  local skills="$HOME/.config/opencode/skills" name entry
  local backup_root
  backup_root="${XDG_STATE_HOME:-$HOME/.local/state}/yadm/legacy-opencode-skills/$(date +%Y%m%d%H%M%S)"
  [[ -d "$skills" && ! -L "$skills" ]] || return 0

  for name in "${LEGACY_OPENCODE_SKILL_LINKS[@]}"; do
    entry="$skills/$name"
    if [[ -L "$entry" ]] && [[ "$(/usr/bin/readlink "$entry")" == */plugins/ex/skills/"$name" ]]; then
      retire_legacy_opencode_skill "$entry" "$backup_root"
    fi
  done
  for name in "${LEGACY_OPENCODE_SKILL_DIRS[@]}"; do
    entry="$skills/$name"
    if [[ -d "$entry" && ! -L "$entry" ]] && grep -qx "name: $name" "$entry/SKILL.md" 2>/dev/null; then
      retire_legacy_opencode_skill "$entry" "$backup_root"
    fi
  done

  rmdir "$skills" 2>/dev/null || true
}

"$YADM_BIN" config yadm.alt-copy true
"$YADM_BIN" alt

configure_submodule_fetch_policy

copy_if_missing "$YADM_DIR/templates/claude-settings.json" "$HOME/.claude/settings.json"
copy_if_missing "$YADM_DIR/templates/codex-config.toml" "$HOME/.codex/config.toml"
configure_agent_skills
retire_legacy_opencode_skills

if is_work_machine; then
  configure_submodule_active true
  configure_submodule_update_strategy
  "$YADM_BIN" submodule sync --recursive
  "$YADM_BIN" submodule update --init --recursive

  "$SCRIPTS_DIR/register-ex-plugins"
  remove_legacy_opencode_skills_link

  if ! command -v orca >/dev/null 2>&1; then
    printf '%s\n' "Orca is not reachable from this shell; rerun bootstrap once it is."
  elif [[ ! -x "$ORCA_CONFIGURE" ]]; then
    printf '%s\n' "ex submodule is not initialized; skipping Orca configuration."
  else
    "$ORCA_CONFIGURE" || printf '%s\n' "Orca configuration incomplete; apply the manual Settings edits listed above."
  fi
else
  configure_submodule_active false
  work_artifacts=0
  if [[ -f "$HOME/.config/opencode/plugins/ex.ts" ]] && grep -q 'Generic bootstrap for OpenCode integrations shipped inside the `ex`' "$HOME/.config/opencode/plugins/ex.ts"; then
    rm "$HOME/.config/opencode/plugins/ex.ts"
    work_artifacts=1
  fi
  if [[ -L "$HOME/.config/opencode/skills" ]] && [[ "$(/usr/bin/readlink "$HOME/.config/opencode/skills")" == ../../.agents/plugins/ex/skills ]]; then
    remove_legacy_opencode_skills_link
    work_artifacts=1
  fi
  if [[ "$work_artifacts" == 1 ]]; then
    "$SCRIPTS_DIR/register-ex-plugins" --remove
  fi
fi

if command -v wt >/dev/null 2>&1; then
  "$SCRIPTS_DIR/generate-worktrunk-config"
else
  printf '%s\n' "Worktrunk is not installed; run generate-worktrunk-config after installing wt."
fi

if command -v herdr >/dev/null 2>&1; then
  herdr plugin link "$HOME/.config/herdr/plugins/sysmon"
else
  printf '%s\n' "Herdr is not installed; install integrations through the Herdr TUI when available."
fi

if [[ ! -d "$HOME/.config/opencode/node_modules" ]]; then
  printf '%s\n' "OpenCode dependencies are absent; run: npm ci --prefix ~/.config/opencode"
fi
