#!/usr/bin/env bash
set -euo pipefail

readonly YADM_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/yadm"
readonly SCRIPTS_DIR="$YADM_DIR/scripts"

if command -v yadm >/dev/null 2>&1; then
  readonly YADM_BIN="$(command -v yadm)"
elif [[ -x /usr/bin/yadm ]]; then
  readonly YADM_BIN=/usr/bin/yadm
else
  printf '%s\n' 'yadm is required to run bootstrap.' >&2
  exit 1
fi

is_work_machine() {
  "$YADM_BIN" config --get-all local.class 2>/dev/null | grep -qx 'Work'
}

copy_if_missing() {
  local source=$1 destination=$2
  if [[ ! -e "$destination" ]]; then
    mkdir -p "$(dirname "$destination")"
    cp "$source" "$destination"
    printf 'Seeded %s\n' "$destination"
  fi
}

replace_legacy_skills_link() {
  local destination=$1 target=$2
  if [[ -L "$destination" ]]; then
    [[ "$(/usr/bin/readlink "$destination")" == "$target" ]] || {
      printf 'Refusing to replace skills link with a different target: %s\n' "$destination" >&2
      exit 1
    }
    rm "$destination"
  elif [[ -e "$destination" && ! -d "$destination" ]]; then
    printf 'Refusing to replace non-directory skills path: %s\n' "$destination" >&2
    exit 1
  fi
  mkdir -p "$destination"
}

configure_agent_skills() {
  local claude_skills="$HOME/.claude/skills"
  local codex_skills="$HOME/.codex/skills"
  local legacy_system_skills="$HOME/.agents/skills/.system"
  local claude_commit_message="$claude_skills/commit-message"

  replace_legacy_skills_link "$codex_skills" '../.agents/skills'
  if [[ -e "$legacy_system_skills" ]]; then
    [[ ! -e "$codex_skills/.system" ]] || {
      printf 'Refusing to overwrite Codex system skills: %s\n' "$codex_skills/.system" >&2
      exit 1
    }
    mv "$legacy_system_skills" "$codex_skills/.system"
  fi

  replace_legacy_skills_link "$claude_skills" '../.agents/skills'
  if [[ ! -e "$claude_commit_message" ]]; then
    ln -s ../../.agents/skills/commit-message "$claude_commit_message"
  elif [[ -L "$claude_commit_message" ]] && [[ "$(/usr/bin/readlink "$claude_commit_message")" != ../../.agents/skills/commit-message ]]; then
    printf 'Refusing to replace Claude commit-message link with a different target.\n' >&2
    exit 1
  elif [[ ! -L "$claude_commit_message" ]]; then
    printf 'Refusing to replace Claude commit-message path: %s\n' "$claude_commit_message" >&2
    exit 1
  fi
}

remove_legacy_opencode_skills_link() {
  local skills="$HOME/.config/opencode/skills"
  if [[ -L "$skills" ]] && [[ "$(/usr/bin/readlink "$skills")" == ../../.agents/plugins/ex/skills ]]; then
    rm "$skills"
  fi
}

"$YADM_BIN" config yadm.alt-copy true
"$YADM_BIN" alt

copy_if_missing "$YADM_DIR/templates/claude-settings.json" "$HOME/.claude/settings.json"
copy_if_missing "$YADM_DIR/templates/codex-config.toml" "$HOME/.codex/config.toml"
configure_agent_skills

if is_work_machine; then
  "$YADM_BIN" submodule sync --recursive
  "$YADM_BIN" submodule update --init --recursive

  "$SCRIPTS_DIR/register-ex-plugins"
  remove_legacy_opencode_skills_link
else
  work_artifacts=0
  if [[ -f "$HOME/.config/opencode/plugins/ex.ts" ]] && grep -q 'Generic bootstrap for OpenCode integrations shipped inside the `ex`' "$HOME/.config/opencode/plugins/ex.ts"; then
    rm "$HOME/.config/opencode/plugins/ex.ts"
    work_artifacts=1
  fi
  if [[ -L "$HOME/.config/opencode/skills" ]] && [[ "$(/usr/bin/readlink "$HOME/.config/opencode/skills")" == ../../.agents/plugins/ex/skills ]]; then
    remove_legacy_opencode_skills_link
    work_artifacts=1
  fi
  if [[ "$work_artifacts" == 1 ]]; then
    "$SCRIPTS_DIR/register-ex-plugins" --remove
  fi
fi

if command -v wt >/dev/null 2>&1; then
  "$SCRIPTS_DIR/generate-worktrunk-config"
else
  printf '%s\n' "Worktrunk is not installed; run generate-worktrunk-config after installing wt."
fi

if ! command -v herdr >/dev/null 2>&1; then
  printf '%s\n' "Herdr is not installed; install integrations through the Herdr TUI when available."
fi

if [[ ! -d "$HOME/.config/opencode/node_modules" ]]; then
  printf '%s\n' "OpenCode dependencies are absent; run: npm ci --prefix ~/.config/opencode"
fi
