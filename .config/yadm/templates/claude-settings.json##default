{
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "model": "opus",
  "permissions": {
    "allow": [
      "Skill(commit-message)",
      "Read(/tmp/**)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git -C * commit*)",
      "Bash(git push*)",
      "Bash(git -C * push*)",
      "Bash(git rebase*)",
      "Bash(git -C * rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git branch -D*)",
      "Bash(git -C * branch -D*)",
      "Bash(git branch -d*)",
      "Bash(git -C * branch -d*)",
      "Bash(git tag -d*)",
      "Bash(git tag --delete*)",
      "Bash(git -C * tag -d*)",
      "Bash(git -C * tag --delete*)",
      "Bash(git worktree*)",
      "Bash(git -C * worktree*)",
      "Bash(git clean *)",
      "Bash(git -C * clean *)",
      "Bash(git restore *)",
      "Bash(git -C * restore *)",
      "Bash(git checkout -- *)",
      "Bash(git -C * checkout -- *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(unlink *)",
      "Bash(shred *)",
      "Bash(find * -delete *)",
      "Bash(find * -exec *)",
      "Bash(sh -c *)",
      "Bash(bash -c *)",
      "Bash(zsh -c *)",
      "Bash(sudo *)",
      "Bash(doas *)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(yarn npm publish *)",
      "Bash(cargo publish *)",
      "Bash(twine upload *)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh pr review*)",
      "Bash(gh issue create*)",
      "Bash(gh issue close*)",
      "Bash(gh issue edit*)",
      "Bash(gh release create*)",
      "Bash(gh release delete*)"
    ]
  },
  "statusLine": {
    "command": "~/.claude/statusline.sh",
    "padding": 0,
    "type": "command"
  },
  "teammateMode": "auto",
  "theme": "dark-ansi",
  "tui": "fullscreen"
}
