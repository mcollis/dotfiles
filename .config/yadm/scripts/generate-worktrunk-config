#!/usr/bin/env bash
set -euo pipefail

readonly CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/worktrunk"
readonly TARGET="$CONFIG_DIR/config.toml"
readonly BASE="$CONFIG_DIR/base.toml"
readonly EX_FRAGMENT="$HOME/.agents/plugins/ex/contrib/worktrunk/ex.toml"
readonly DEPOT_FRAGMENT="$HOME/.agents/projects/depot/worktrunk/depot.toml"
readonly BACKUP_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/yadm/worktrunk"
readonly LOCK_DIR="${XDG_RUNTIME_DIR:-/tmp}/yadm-worktrunk-config.lock"

if command -v yadm >/dev/null 2>&1; then
  readonly YADM_BIN="$(command -v yadm)"
elif [[ -x /usr/bin/yadm ]]; then
  readonly YADM_BIN=/usr/bin/yadm
else
  printf '%s\n' 'yadm is required to generate Worktrunk configuration.' >&2
  exit 1
fi

MODE=apply
case "${1:-}" in
  '') ;;
  --check) MODE=check ;;
  --dry-run) MODE=dry-run ;;
  *) printf 'usage: %s [--check|--dry-run]\n' "$0" >&2; exit 2 ;;
esac

is_work_machine() {
  "$YADM_BIN" config --get-all local.class 2>/dev/null | grep -qx 'Work'
}

command -v wt >/dev/null 2>&1 || {
  printf '%s\n' 'Worktrunk is required to generate and validate its configuration.' >&2
  exit 1
}
[[ -f "$BASE" ]] || {
  printf '%s\n' "Missing yadm-selected Worktrunk base: $BASE" >&2
  exit 1
}

if [[ "$MODE" == apply ]]; then
  mkdir -p "$CONFIG_DIR"
  tmp=$(mktemp "$CONFIG_DIR/.config.toml.XXXXXX")
else
  tmp=$(mktemp "${TMPDIR:-/tmp}/yadm-worktrunk-config.XXXXXX")
fi
cleanup() { rm -f "$tmp"; }
trap cleanup EXIT

printf '%s\n\n' \
  '# Generated by ~/.config/yadm/scripts/generate-worktrunk-config.' \
  '# Edit ~/.config/worktrunk/base.toml, then regenerate.' > "$tmp"

if is_work_machine; then
  [[ -f "$EX_FRAGMENT" && -f "$DEPOT_FRAGMENT" ]] || {
    printf '%s\n' 'Work configuration requires initialized EX and Depot submodules.' >&2
    exit 1
  }
  cat "$EX_FRAGMENT" >> "$tmp"
  printf '\n\n' >> "$tmp"
  cat "$BASE" >> "$tmp"
  printf '\n\n' >> "$tmp"
  cat "$DEPOT_FRAGMENT" >> "$tmp"
else
  cat "$BASE" >> "$tmp"
fi

wt --config "$tmp" config show >/dev/null

if [[ -f "$TARGET" ]] && cmp -s "$tmp" "$TARGET"; then
  printf '%s\n' 'Worktrunk configuration is current.'
  exit 0
fi

if [[ "$MODE" == check ]]; then
  printf '%s\n' 'Worktrunk configuration is stale.' >&2
  exit 1
fi

if [[ "$MODE" == dry-run ]]; then
  diff -u "$TARGET" "$tmp" || true
  exit 0
fi

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  printf '%s\n' 'Another Worktrunk generation is already running.' >&2
  exit 1
fi
trap 'rmdir "$LOCK_DIR"; cleanup' EXIT

if [[ -f "$TARGET" ]] && cmp -s "$tmp" "$TARGET"; then
  printf '%s\n' 'Worktrunk configuration is current.'
  exit 0
fi

if [[ -f "$TARGET" ]]; then
  mkdir -p "$BACKUP_DIR"
  cp "$TARGET" "$BACKUP_DIR/config.$(date +%Y%m%d%H%M%S).toml"
fi
mv "$tmp" "$TARGET"
printf 'Generated %s\n' "$TARGET"
