# direnvrc — Mike Collis
#
# Provides update_labels() for .envrc files to call AT THE END
# (after exports are defined, so UI_PORT/TICKET_ID are visible).
#
# Reads:
#   TICKET_ID  → slug for the webpack log/pidfile (falls back to branch name)
#   UI_PORT    → appended to the Orca workspace display name
#
# Exports (for shells, hooks, skills):
#   WEBPACK_LOG     /tmp/depot-webpack-<slug>.log
#   WEBPACK_PIDFILE /tmp/depot-webpack-<slug>.pid

update_labels() {
    local slug="${TICKET_ID:-}"
    if [ -z "$slug" ]; then
        local br
        br=$(git rev-parse --abbrev-ref HEAD 2>/dev/null | tr '/' '-')
        if [ -n "$br" ] && [ "$br" != "HEAD" ]; then
            slug="$br"
        else
            slug=$(basename "$PWD")
        fi
    fi
    export WEBPACK_LOG="/tmp/depot-webpack-${slug}.log"
    export WEBPACK_PIDFILE="/tmp/depot-webpack-${slug}.pid"

    _depot_compose_project
    _orca_update_labels
}

# Makes depot's Makefile use the lowercase Compose project name the agent
# scripts use. Compose rejects uppercase (e.g. an Orca worktree named EX-123),
# and the Makefile's own derivation preserves case. A plain env var would lose
# to the Makefile's assignment, but a MAKEFLAGS variable override wins like a
# command-line one. No-op in repos that don't ship the helper.
_depot_compose_project() {
    local root lib
    root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
    lib="$root/.agents/lib/compose-project-name.sh"
    [ -f "$lib" ] || return 0
    watch_file "$lib" 2>/dev/null || true

    # shellcheck source=/dev/null
    source "$lib"
    export MAKEFLAGS="${MAKEFLAGS:+$MAKEFLAGS }DC_PROJECT=$(compose_project_name "$root")"
}

# Appends ":<UI_PORT>" to the Orca workspace display name (and strips it when
# UI_PORT is unset). The CLI mechanics live in the depot bundle's lib/orca.sh,
# projected into each worktree's .agents/, so this is a no-op in any repo that
# doesn't ship it. Also a no-op outside Orca. direnv runs this synchronously,
# so the CLI timeout is kept short.
_orca_update_labels() {
    [ -n "${ORCA_WORKTREE_ID:-}" ] || return 0

    local root lib
    root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
    lib="$root/.agents/lib/orca.sh"
    [ -f "$lib" ] || return 0
    # Reload when the helper changes, so edits to it take effect.
    watch_file "$lib" 2>/dev/null || true

    (
        # shellcheck source=/dev/null
        source "$lib"
        ORCA_CLI_TIMEOUT="${ORCA_LABEL_TIMEOUT:-3}" \
            orca_refresh_port_label "$root" "${UI_PORT:-}"
    ) || true
}
