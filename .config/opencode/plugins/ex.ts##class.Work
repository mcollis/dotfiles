import { Plugin } from "@opencode/plugin"
import { existsSync } from "node:fs"
import { pathToFileURL } from "node:url"
import { redactText } from "./secret-redactor.ts"

// Generic bootstrap for OpenCode integrations shipped inside the `ex`
// plugin submodule (shared with Claude Code/Codex — see
// ~/.agents/plugins/ex). This file is intentionally tiny and knows
// nothing about what `ex` actually does: it just loads `ex`'s OpenCode
// entry point and hands it the plugin context, returning whatever cleanup
// function that produces. Adding, removing, or changing an `ex` OpenCode
// integration (context-checkpoint today, possibly others later) should
// never require touching dotfiles again — only
// ~/.agents/plugins/ex/integrations/opencode/.
//
// The one thing it does supply is `redact`: the checkpoint renderer sends
// session text to a model through a path the secret-redactor session hooks do
// not cover, so the same scrubber is handed in rather than duplicated.
const ENTRY = `${process.env.HOME}/.agents/plugins/ex/integrations/opencode/index.ts`

export default Plugin.define({
  id: "ex",
  async setup(ctx) {
    if (!existsSync(ENTRY)) {
      console.warn(
        `[ex-loader] ex OpenCode integration not found at ${ENTRY} — is the ex submodule checked out? ` +
          "(yadm submodule update --init --recursive, then yadm bootstrap)",
      )
      return
    }

    const mod = await import(pathToFileURL(ENTRY).href)
    const createPlugin = mod.default
    if (typeof createPlugin !== "function") return

    return createPlugin({ redact: redactText })(ctx)
  },
})
